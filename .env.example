ECHO_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Only needed when ECHO_LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=
ECHO_DATABASE_URL=sqlite:///./echo.db
ECHO_DEMO_USER=local-demo
# Hosted demos use a generated server secret and managed PostgreSQL.
# ECHO_PUBLIC_DEMO=true
# ECHO_BROWSER_SECRET=
# ECHO_FRONTEND_ORIGIN=
ECHO_TURN_TIMEOUT=35
ECHO_MODEL_TIMEOUT=12
ECHO_SEARCH_TIMEOUT=8
ECHO_MAX_SEARCH_CALLS=2
ECHO_MAX_SEARCH_RESULTS=4
ECHO_TTL_NEWS=900
ECHO_TTL_MARKET=3600
ECHO_TTL_RELEASE=21600
ECHO_TTL_GENERAL=86400
ECHO_SEARCH_CACHE_SIZE=256
ECHO_LOG_LEVEL=INFO

